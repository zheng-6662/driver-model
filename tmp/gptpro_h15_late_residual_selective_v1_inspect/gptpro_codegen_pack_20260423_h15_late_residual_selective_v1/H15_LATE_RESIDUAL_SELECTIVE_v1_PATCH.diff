+def _denorm_y(y_norm_np: np.ndarray, y_mean: np.ndarray, y_std: np.ndarray) -> np.ndarray:
+    # y_norm_np: (N,T,3)
+    return y_norm_np * y_std.reshape(1, 1, 3) + y_mean.reshape(1, 1, 3)
